{
  "name": "slidev-theme-csscade",
  "version": "0.0.4",
  "description": "A Csscade theme for Slidev",
  "author": "Manon Carbonnel",
  "license": "MIT",
  "homepage": "https://csscade.github.io/slidev-theme-csscade",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Csscade/slidev-theme-csscade.git"
  },
  "bugs": {
    "url": "https://github.com/Csscade/slidev-theme-csscade/issues"
  },
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": ">=18.0.0",
    "slidev": ">=0.19.3"
  },
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png --dark"
  },
  "dependencies": {
    "@slidev/types": "^0.49.28",
    "codemirror-theme-vars": "^0.1.2",
    "prism-theme-vars": "^0.2.5",
    "sass": "^1.97.3"
  },
  "devDependencies": {
    "@slidev/cli": "^0.49.28",
    "playwright-chromium": "^1.58.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.0.0",
    "stylelint-config-recommended": "^18.0.0"
  },
  "//": "Learn more: https://sli.dev/themes/write-a-theme.html",
  "slidev": {
    "colorSchema": "both",
    "highlighter": "all",
    "defaults": {
      "fonts": {
        "sans": "Poppins",
        "mono": "Fira Code"
      },
      "favicon": "/favicon.png"
    }
  },
  "files": [
    "components",
    "helpers",
    "layouts",
    "public/arrow.png",
    "public/favicon.png",
    "public/iphone-15-pro-max-frame.png",
    "public/macbook-air-frame.png",
    "setup",
    "styles",
    "README.md",
    "package.json"
  ]
}
